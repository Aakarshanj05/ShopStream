# Copy to .env for local runs. Never commit .env or actual credentials.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPARK_MASTER=spark://spark-master:7077
SHOPSTREAM_DATA_ROOT=/opt/spark-data

# Lakehouse services (only used after the isolated lakehouse stack is configured)
MINIO_ROOT_USER=shopstream
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_ACCESS_KEY=shopstream
MINIO_SECRET_KEY=replace-with-a-different-long-random-secret
MINIO_LICENSE_FILE=./secrets/minio.license
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=shopstream-warehouse
NESSIE_URI=http://nessie:19120/api/v2
NESSIE_BRANCH=main

# SeaweedFS for the isolated, persistent S3-compatible lakehouse canary.
SEAWEEDFS_ACCESS_KEY=replace-with-a-long-random-access-key
SEAWEEDFS_SECRET_KEY=replace-with-a-long-random-secret
SEAWEEDFS_BUCKET=shopstream-warehouse
ICEBERG_CANARY_MODE=write
ICEBERG_CANARY_RUN_ID=shopstream-persistence-20261106

# New ShopStream Airflow only. Keep independent of the older Airflow setup.
AIRFLOW_UI_PORT=8082
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-long-random-password
AIRFLOW_FERNET_KEY=generate-a-fernet-key
AIRFLOW_DB_PASSWORD=replace-with-a-long-random-password

AIRFLOW_WEB_SECRET_KEY=replace-with-a-long-random-secret
NESSIE_DB_PASSWORD=replace-with-a-long-random-password
ICEBERG_RUN_SCHEMA_EVOLUTION_CHECK=false
ICEBERG_CREATE_TEST_BRANCH=false

# Shared Airflow 3 task-token signing secret (generate at least 64 random bytes).
AIRFLOW_JWT_SECRET=replace-with-a-64-byte-random-secret
